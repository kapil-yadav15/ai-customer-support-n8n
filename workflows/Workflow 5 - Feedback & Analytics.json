    {
      "parameters": {
        "jsCode": "// Aggregate ticket and feedback data into a summary for the AI report\nconst allItems = $input.all();\n\n// Separate tickets and feedback based on which fields are present\nconst tickets = allItems.filter(i => i.json['Ticket ID'] && i.json.Category !== undefined);\nconst feedbackEntries = allItems.filter(i => i.json.Rating !== undefined);\n\nconst totalTickets = tickets.length;\nconst categoryCounts = {};\nconst priorityCounts = {};\nlet resolvedCount = 0;\n\nfor (const t of tickets) {\n  const cat = t.json.Category || 'Uncategorized';\n  const pri = t.json.Priority || 'Unspecified';\n  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;\n  priorityCounts[pri] = (priorityCounts[pri] || 0) + 1;\n  if ((t.json.Status || '').toString().toLowerCase().includes('resolved')) {\n    resolvedCount++;\n  }\n}\n\nconst ratings = feedbackEntries\n  .map(f => parseFloat(f.json.Rating))\n  .filter(r => !isNaN(r));\nconst avgRating = ratings.length ? (ratings.reduce((a, b) => a + b, 0) / ratings.length).toFixed(2) : 'N/A';\n\nconst summaryText = `\nTotal Tickets: ${totalTickets}\nResolved Tickets: ${resolvedCount}\nCategory Breakdown: ${JSON.stringify(categoryCounts)}\nPriority Breakdown: ${JSON.stringify(priorityCounts)}\nTotal Feedback Received: ${feedbackEntries.length}\nAverage Rating: ${avgRating}\n`;\n\nreturn [{\n  json: {\n    summaryText,\n    totalTickets,\n    resolvedCount,\n    avgRating,\n    feedbackCount: feedbackEntries.length\n  }\n}];"
      },
      "id": "b2fa4db0-1e72-4f62-a97f-d0ed5a0e2966",
      "name": "Aggregate Weekly Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        384
      ]
    },
    {
      "parameters": {
        "sendTo": "kapilydv40@gmail.com",
        "subject": "=Weekly Support Analytics Report - {{ $now.format('dd LLL yyyy') }}",
        "message": "=Dear Manager,<br><br>Please find below the automated weekly support performance summary.<br><br><b>Key Statistics:</b><br>Total Tickets: {{ $('Aggregate Weekly Stats').item.json.totalTickets }}<br>Resolved Tickets: {{ $('Aggregate Weekly Stats').item.json.resolvedCount }}<br>Feedback Responses: {{ $('Aggregate Weekly Stats').item.json.feedbackCount }}<br>Average Rating: {{ $('Aggregate Weekly Stats').item.json.avgRating }} / 5<br><br><b>AI-Generated Summary:</b><br>{{ $json.output ? $json.output[0].content[0].text : $json.message.content }}<br><br>Best regards,<br>Automated Analytics System",
        "options": {}
      },
