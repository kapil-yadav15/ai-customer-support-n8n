    {
      "parameters": {
        "jsCode": "// Get the AI response text from the new node's output structure\nconst item = $input.first().json;\nlet raw = '';\n\nif (item.output && item.output[0] && item.output[0].content) {\n  raw = item.output[0].content[0].text || '';\n} else if (item.message?.content) {\n  raw = item.message.content;\n} else if (item.text) {\n  raw = item.text;\n}\n\nlet cleaned = raw.trim();\ncleaned = cleaned.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    category: 'General',\n    priority: 'Medium',\n    sentiment: 'Neutral',\n    reason: 'Could not parse AI response'\n  };\n}\n\nreturn [{\n  json: {\n    TicketID: $('Google Sheets Trigger').item.json['Ticket ID'],\n    Category: parsed.category,\n    Priority: parsed.priority,\n    Sentiment: parsed.sentiment,\n    Reason: parsed.reason\n  }\n}];"
      },
